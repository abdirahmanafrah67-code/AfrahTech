# ── NOWPayments (International Payment Gateway) ──────────────────────────────
# Get your API key from: https://nowpayments.io → Settings → API Keys
NOWPAYMENTS_API_KEY=your_nowpayments_api_key_here

# Your USDT (TRC-20) wallet address — money arrives here
# Get from Binance App → Receive → USDT → TRC-20 network
# NOWPAYMENTS_PAYOUT_ADDRESS=TXxxxxxxxxxxxxxxxxxxxxxxxxx  (set in NOWPayments dashboard, not here)

# Payment redirect URLs (update to your real domain)
